# ── Backend (uvicorn / systemd EnvironmentFile) ─────────────────────
# Folder for the SQLite database, imported routes and the uploaded logo
TOPO_DATA_DIR=./data
# Optional: any SQLAlchemy URL instead of the SQLite file
# DATABASE_URL=sqlite:////absolute/path/topo.db

# Comma-separated origins allowed to call the API (not needed behind the nginx config)
CORS_ORIGINS=http://localhost:5173

# Basemap in PDF reports. MAP_TILES=off disables it (no network calls).
MAP_TILES=on
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# OSM tile usage policy: identify your deployment with a contact address
MAP_USER_AGENT=topo-survey/1.0 (contact: you@example.com)

# ── Frontend (vite) ─────────────────────────────────────────────────
# VITE_API_BASE=/api
# VITE_API_PROXY=http://localhost:8000
